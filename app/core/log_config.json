{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "app": {
      "format": "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s",
      "datefmt": "%Y-%m-%d %H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "app",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": { "handlers": ["console"], "level": "INFO", "propagate": false },
    "uvicorn.error": { "handlers": ["console"], "level": "INFO", "propagate": false },
    "uvicorn.access": { "handlers": [], "level": "WARNING", "propagate": false },
    "sqlalchemy": { "handlers": [], "level": "WARNING", "propagate": false },
    "sqlalchemy.engine": { "handlers": [], "level": "WARNING", "propagate": false },
    "sqlalchemy.engine.Engine": { "handlers": [], "level": "WARNING", "propagate": false },
    "watchfiles": { "handlers": [], "level": "WARNING", "propagate": false },
    "watchfiles.main": { "handlers": [], "level": "WARNING", "propagate": false }
  },
  "root": {
    "handlers": ["console"],
    "level": "INFO"
  }
}
